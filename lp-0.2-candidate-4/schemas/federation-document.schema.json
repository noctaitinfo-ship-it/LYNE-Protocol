{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "federation-document.schema.json",
 "title": "LP 0.2 federation-document (PRIVATE, EXPERIMENTAL, UNPUBLISHED, NOT LP 0.1)",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "v",
  "origin",
  "tenant",
  "implementation",
  "lp",
  "modules",
  "provider_pub",
  "issued_at",
  "expires_at",
  "signature"
 ],
 "properties": {
  "v": {
   "const": "lp02.federation/1"
  },
  "origin": {
   "type": "string",
   "pattern": "^(https://[A-Za-z0-9.-]+(:[0-9]{1,5})?|http://127\\.0\\.0\\.1:[0-9]{1,5})$"
  },
  "tenant": {
   "type": "string",
   "pattern": "^(default|[A-Za-z0-9_-]{22})$"
  },
  "implementation": {
   "type": "object",
   "additionalProperties": false,
   "required": [
    "name",
    "version"
   ],
   "properties": {
    "name": {
     "type": "string",
     "minLength": 1,
     "maxLength": 64
    },
    "version": {
     "type": "string",
     "minLength": 1,
     "maxLength": 32
    }
   }
  },
  "lp": {
   "type": "array",
   "minItems": 1,
   "uniqueItems": true,
   "items": {
    "enum": [
     "0.1",
     "0.2"
    ]
   }
  },
  "modules": {
   "type": "object",
   "propertyNames": {
    "pattern": "^lp02\\.[a-z]{1,32}$"
   },
   "additionalProperties": {
    "type": "array",
    "minItems": 1,
    "uniqueItems": true,
    "items": {
     "type": "integer",
     "minimum": 1,
     "maximum": 999999
    }
   }
  },
  "provider_pub": {
   "type": "string",
   "pattern": "^[A-Za-z0-9_-]{43}$"
  },
  "issued_at": {
   "type": "integer",
   "minimum": 0
  },
  "expires_at": {
   "type": "integer",
   "minimum": 0
  },
  "signature": {
   "type": "string",
   "pattern": "^[A-Za-z0-9_-]+\\.\\.[A-Za-z0-9_-]+$"
  }
 }
}
