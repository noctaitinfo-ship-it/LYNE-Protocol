{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "client-modules.schema.json",
 "title": "LP 0.2 client-modules (PRIVATE, EXPERIMENTAL, UNPUBLISHED, NOT LP 0.1)",
 "type": "object",
 "additionalProperties": false,
 "required": [
  "v",
  "modules"
 ],
 "properties": {
  "v": {
   "const": "lp02.federation/1"
  },
  "modules": {
   "type": "object",
   "additionalProperties": false,
   "properties": {
    "lp02.request": {
     "type": "array",
     "minItems": 1,
     "uniqueItems": true,
     "items": {
      "type": "integer",
      "minimum": 1,
      "maximum": 999999
     }
    },
    "lp02.wake": {
     "type": "array",
     "minItems": 1,
     "uniqueItems": true,
     "items": {
      "type": "integer",
      "minimum": 1,
      "maximum": 999999
     }
    },
    "lp02.linecaps": {
     "type": "array",
     "minItems": 1,
     "uniqueItems": true,
     "items": {
      "type": "integer",
      "minimum": 1,
      "maximum": 999999
     }
    },
    "lp02.exit": {
     "type": "array",
     "minItems": 1,
     "uniqueItems": true,
     "items": {
      "type": "integer",
      "minimum": 1,
      "maximum": 999999
     }
    }
   }
  }
 }
}
