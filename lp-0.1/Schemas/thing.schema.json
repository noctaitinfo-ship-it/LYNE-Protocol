{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lyne.invalid/lp/0.1/thing.schema.json",
  "title": "LYNE LP 0.1 Thing",
  "description": "Provider-created, provider-signed work object; the primary abstraction of LP 0.1. See PROTOCOL.md section 3.",
  "type": "object",
  "required": ["lp_version", "thing_id", "type", "title", "provider_pub", "created_at", "closed_at", "version", "signature"],
  "additionalProperties": false,
  "properties": {
    "lp_version": { "const": "0.1" },
    "thing_id": { "$ref": "#/$defs/id" },
    "type": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 140 },
    "provider_pub": { "$ref": "#/$defs/public_key" },
    "created_at": { "$ref": "#/$defs/timestamp" },
    "closed_at": {
      "type": ["string", "null"],
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "version": { "$ref": "#/$defs/positive_counter" },
    "signature": { "$ref": "#/$defs/detached_jws" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{22}$" },
    "public_key": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "positive_counter": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "detached_jws": { "type": "string", "pattern": "^[A-Za-z0-9_-]+\\.\\.[A-Za-z0-9_-]{86}$" }
  }
}
