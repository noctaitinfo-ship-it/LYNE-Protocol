{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lyne.invalid/lp/0.1/grant.schema.json",
  "title": "LYNE LP 0.1 Grant",
  "description": "Provider-issued, Thing-bound, one-time-redeemable authorization for bounded Live Lines. Field semantics adapted from the A2R draft (draft-das-6g-query-scoped-communication-handles-06). The raw Grant Secret is never part of this object; the bearer phase ends at redeem_by (at most 15 minutes after issuance). See PROTOCOL.md section 5.",
  "type": "object",
  "required": ["lp_version", "grant_id", "thing_id", "issuer", "subject", "aud", "purpose", "channels", "issued_at", "redeem_by", "not_before", "exp", "line_max_seconds", "max_uses", "epoch", "secret_commitment", "signature"],
  "additionalProperties": false,
  "properties": {
    "lp_version": { "const": "0.1" },
    "grant_id": { "$ref": "#/$defs/id" },
    "thing_id": { "$ref": "#/$defs/id" },
    "issuer": { "$ref": "#/$defs/public_key" },
    "subject": { "const": "client" },
    "aud": { "type": "string", "pattern": "^https://[a-z0-9.-]+(:[0-9]{1,5})?$" },
    "purpose": { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,64}$" },
    "channels": {
      "type": "array",
      "items": { "enum": ["voice", "video", "data"] },
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true
    },
    "issued_at": { "$ref": "#/$defs/timestamp" },
    "redeem_by": {
      "$ref": "#/$defs/timestamp",
      "description": "End of the bearer phase; issued_at < redeem_by <= issued_at + 900 s and <= exp (PROTOCOL.md section 5.3; checked by tests, not expressible in JSON Schema)."
    },
    "not_before": { "$ref": "#/$defs/timestamp" },
    "exp": { "$ref": "#/$defs/timestamp" },
    "line_max_seconds": { "type": "integer", "minimum": 60, "maximum": 86400 },
    "max_uses": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
    "epoch": { "type": "integer", "minimum": 0, "maximum": 2147483647 },
    "secret_commitment": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
    "signature": { "$ref": "#/$defs/detached_jws" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_-]{22}$" },
    "public_key": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "detached_jws": { "type": "string", "pattern": "^[A-Za-z0-9_-]+\\.\\.[A-Za-z0-9_-]{86}$" }
  }
}
